# Sem estas duas variáveis o app roda em modo demo (dados no navegador, IA local).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# claude (padrão, via Edge Function) | heuristic (sem IA generativa)
VITE_AI_ENGINE=claude
# Endereço público da Fábrica, base dos links curtos /l/<código>. Sem ele, usa o endereço aberto no navegador.
VITE_APP_URL=https://fabrica-s.netlify.app
